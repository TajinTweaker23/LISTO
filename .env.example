# Environment Variables Configuration

# Copy this file to .env.local for development
# For production, set these in your hosting platform (Vercel, etc.)

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=LISTO
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# Firebase Configuration (Client-side - Public)
# =============================================================================
# Get these from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================================================================
# Firebase Admin SDK (Server-side - Secret)
# =============================================================================
# Get this from Firebase Console > Project Settings > Service Accounts
# Download the service account JSON and set the path or inline the key
FIREBASE_ADMIN_SDK_KEY=your_admin_sdk_private_key_json
# Or use a path to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# =============================================================================
# Firebase Data Connect (if using)
# =============================================================================
NEXT_PUBLIC_FIREBASE_DATA_CONNECT_URL=your_dataconnect_url

# =============================================================================
# Genkit AI Configuration (Optional)
# =============================================================================
# For AI-powered features
GENKIT_ENV=prod
GOOGLE_GENAI_API_KEY=your_genai_api_key_here

# =============================================================================
# Analytics & Monitoring (Optional)
# =============================================================================
# Vercel Analytics (enabled by default on Vercel)
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# CopilotKit Configuration (Optional)
# =============================================================================
# If using CopilotKit features
COPILOT_CLOUD_API_KEY=your_copilotkit_api_key

# =============================================================================
# API Keys for External Services (Optional)
# =============================================================================
# Google Maps API (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Groq API (for AI features)
GROQ_API_KEY=your_groq_api_key

# =============================================================================
# Security & Authentication
# =============================================================================
# JWT Secret for token signing (generate a random string)
JWT_SECRET=your_very_long_random_secret_string_here

# Session secret (generate a random string)
SESSION_SECRET=another_very_long_random_secret_string

# =============================================================================
# Database Configuration
# =============================================================================
# Firestore settings
FIRESTORE_EMULATOR_HOST=localhost:8080  # Only for local development

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# =============================================================================
# Performance & Optimization
# =============================================================================
# CDN Configuration (if using custom CDN)
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Image optimization
NEXT_PUBLIC_IMAGE_DOMAINS=firebasestorage.googleapis.com,yourdomain.com

# =============================================================================
# Development Settings (Local Only)
# =============================================================================
# These should NOT be set in production
# PORT=3000
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 1. Never commit .env or .env.local files to git
# 2. NEXT_PUBLIC_* variables are exposed to the browser
# 3. Variables without NEXT_PUBLIC_ are server-side only
# 4. Rotate all secrets regularly (at least every 90 days)
# 5. Use different values for dev, staging, and production
# 6. Store production secrets in your hosting platform's secret manager
#    - Vercel: Project Settings > Environment Variables
#    - Firebase: Use Firebase Config or Secret Manager
# 7. For sensitive data, consider using a secret manager:
#    - Google Secret Manager
#    - AWS Secrets Manager
#    - HashiCorp Vault
